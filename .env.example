APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///instance/logivoice.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=25
TOKEN_MAX_AGE_SECONDS=3600
# Optional path to the INSTALLED OCR executable, never the setup installer.
# Windows example: TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"
# Render Docker: leave blank to use Linux Tesseract from PATH.
TESSERACT_PATH=

# local is appropriate for development/tests only; use s3 in production.
STORAGE_BACKEND=local
STORAGE_ROOT=instance/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional server-side provider. Leave blank to receive a documented 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
